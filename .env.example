# ==============================================================================
# صاحب يومك · Day Companion - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Turso / libSQL Database (Backend Only - NEVER expose to browser / No VITE_ prefix)
# ------------------------------------------------------------------------------
# [Development]:
TURSO_DATABASE_URL=file:dev.db
TURSO_AUTH_TOKEN=

# [Production]:
# TURSO_DATABASE_URL=libsql://daycompanion-production.turso.io
# TURSO_AUTH_TOKEN=your_production_turso_auth_token

# ------------------------------------------------------------------------------
# 2. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Trust Proxy configuration for Express:
# Number of reverse proxy hops to trust for accurate client IP detection and rate limiting
# Set to 1 when deployed behind Google Cloud Run, Nginx, or Cloudflare; leave blank/0 for false.
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 3. Client Configuration (Client Safe - Exposed to browser / Starts with VITE_)
# ------------------------------------------------------------------------------
# Public HTTPS production backend base URL for the Android Capacitor App.
# Leave blank to run in fully local-first offline mode (no server sync).
VITE_API_BASE_URL=

